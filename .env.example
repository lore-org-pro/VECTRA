# ========================================================
# VECTRA // ARCHIVO DE CONFIGURACIÓN DE ENTORNO (.env)
# ========================================================
# Copia este archivo como .env y coloca tus claves gratuitas.
# Ninguna clave es obligatoria para iniciar: si no tienes claves,
# VECTRA usará Ollama local o el MODO DEMO OFFLINE automáticamente.

# --------------------------------------------------------
# SERVIDOR BACKEND
# --------------------------------------------------------
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --------------------------------------------------------
# 1. GROQ API (Máxima velocidad y baja latencia - Recomendado)
# Obtén tu clave gratis en: https://console.groq.com/keys
# Puedes colocar varias claves separadas por coma para rotación automática.
# --------------------------------------------------------
GROQ_API_KEYS=

# --------------------------------------------------------
# 2. GOOGLE GEMINI API (Google AI Studio)
# Obtén tu clave gratis en: https://aistudio.google.com/
# Soporta varias claves separadas por coma.
# --------------------------------------------------------
GEMINI_API_KEYS=

# --------------------------------------------------------
# 3. OPENROUTER API (Acceso a modelos con sufijo :free)
# Obtén tu clave gratis en: https://openrouter.ai/keys
# --------------------------------------------------------
OPENROUTER_API_KEYS=

# --------------------------------------------------------
# 4. MISTRAL API (La Plateforme)
# Obtén tu clave en: https://console.mistral.ai/
# --------------------------------------------------------
MISTRAL_API_KEYS=

# --------------------------------------------------------
# 5. NVIDIA NIM API
# Obtén tu clave en: https://build.nvidia.com/
# --------------------------------------------------------
NVIDIA_NIM_API_KEYS=

# --------------------------------------------------------
# 6. OLLAMA LOCAL (100% Offline, sin límites de cuota)
# Descarga e instala Ollama desde https://ollama.com
# Descarga el modelo: ollama run qwen2.5:7b o llama3.1
# --------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b

# --------------------------------------------------------
# SÍNTESIS DE VOZ (TTS) - ELEVENLABS
# Obtén tu clave gratis en: https://elevenlabs.io/
# Si no colocas clave o se agotan los créditos, VECTRA usará
# automáticamente la voz en español del navegador (SpeechSynthesis).
# --------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --------------------------------------------------------
# CONFIGURACIÓN GENERAL
# --------------------------------------------------------
DEFAULT_LANGUAGE=es-MX
ENABLE_AUDIO_CACHE=true
MAX_HISTORY_TURNS=6
